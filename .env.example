# Copy to .env (`cp .env.example .env`) before running `docker compose up`.
# compose.yaml reads these for variable interpolation and the app container.

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Connection strings (host names match the compose service names).
DATABASE_URL=postgres://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
